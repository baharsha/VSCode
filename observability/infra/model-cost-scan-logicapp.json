        "headers": {
         "Content-Type": "application/json"
        },
        "body": "@item()",
        "authentication": {
         "type": "ManagedServiceIdentity",
         "audience": "https://monitor.azure.com/"
        }
       }
      }
     }
    },
    "Query_Resource": {
     "type": "Http",
     "runAfter": {},
     "inputs": {
