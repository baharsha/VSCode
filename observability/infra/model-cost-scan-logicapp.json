      }
     },
     "actions": {
      "Post_Resource": {
       "type": "Http",
       "runAfter": {},
       "inputs": {
        "method": "POST",
        "uri": "https://gaih-prd01-modelcost-dcr-2wpr-swedencentral.logs.z1.ingest.monitor.azure.com/dataCollectionRules/dcr-23413457d1334e1eb3de7e61532b6c5c/streams/Custom-GenAIModelCost?api-version=2023-01-01",
