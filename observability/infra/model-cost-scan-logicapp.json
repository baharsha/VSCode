       "UsageDate": "@{concat(substring(string(item()[2]),0,4),'-',substring(string(item()[2]),4,2),'-',substring(string(item()[2]),6,2),'T00:00:00Z')}",
       "Cost": "@float(item()[0])",
       "UsageQuantity": "@float(item()[1])",
       "MeterCategory": "@string(item()[3])",
       "MeterSubCategory": "@string(item()[4])",
       "Meter": "@string(item()[5])",
       "Currency": "@string(item()[6])",
       "Grain": "Monthly",
       "ResourceId": "@''",
       "ScanId": "@{workflow()['run']['name']}"
      }
     }
    },
