       "PeriodStart": "@{formatDateTime(addToTime(startOfMonth(utcNow()), -1, 'Month'), 'yyyy-MM-ddTHH:mm:ssZ')}",
       "PeriodEnd": "@{formatDateTime(utcNow(), 'yyyy-MM-ddTHH:mm:ssZ')}",
       "UsageDate": "@{concat(substring(string(item()[2]),0,4),'-',substring(string(item()[2]),4,2),'-',substring(string(item()[2]),6,2),'T00:00:00Z')}",
       "Cost": "@float(item()[0])",
       "UsageQuantity": "@float(item()[1])",
       "MeterCategory": "@string(item()[4])",
       "MeterSubCategory": "@string(item()[4])",
       "Meter": "@''",
       "Currency": "@string(item()[5])",
       "Grain": "Resource",
       "ResourceId": "@string(item()[3])",
       "ScanId": "@{workflow()['run']['name']}"
      }
     }
    },
    "Ingest_Resource": {
     "type": "Foreach",
     "runAfter": {
      "Shape_Resource": [
       "Succeeded"
      ]
     },
     "foreach": "@chunk(body('Shape_Resource'), 500)",
     "runtimeConfiguration": {
